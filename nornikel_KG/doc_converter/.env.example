# VLM backend: openai | anthropic | local | mock | off
VLM_BACKEND=off

# PDF backend: pymupdf4llm | pymupdf
PDF_BACKEND=pymupdf4llm

# API keys (required when using corresponding VLM backend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OCR language for PaddleOCR fallback on scanned PDF pages
OCR_LANG=ru

# VLM request timeout in seconds
VLM_TIMEOUT_SEC=30

# OpenAI model for vision tasks
OPENAI_VLM_MODEL=gpt-4o-mini

# Anthropic model for vision tasks
ANTHROPIC_VLM_MODEL=claude-3-5-sonnet-20241022

# Yandex Vision OCR (scanned PDF pages without text layer)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
