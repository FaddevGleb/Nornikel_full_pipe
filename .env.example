# Active inference provider: routerai (default) or yandex
LLM_PROVIDER=routerai

# --- RouterAI (https://routerai.ru/) ---
ROUTERAI_API_KEY=your_routerai_api_key_here
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Optional per-stage overrides (RouterAI model ids, e.g. qwen/qwen3.6-flash)
# ROUTERAI_MODEL_HGA=qwen/qwen3.6-flash
# ROUTERAI_MODEL_CRITIC=qwen/qwen3.6-flash
# ROUTERAI_MODEL_CRITIC_2=qwen/qwen3.6-flash
# ROUTERAI_MODEL_CRITIC_3=qwen/qwen3.6-flash
# ROUTERAI_MODEL_SUMMARIZER=qwen/qwen3.6-flash
# ROUTERAI_MODEL_EVALUATION=qwen/qwen3.6-flash
# ROUTERAI_MODEL_KG=qwen/qwen3.6-flash

# --- Yandex AI Studio (set LLM_PROVIDER=yandex) ---
YANDEX_API_KEY=your_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1

# Yandex model names — see https://yandex.cloud/en/docs/ai-studio/concepts/generation/models
YANDEX_MODEL_HGA=qwen3.6-flash/latest
YANDEX_MODEL_CRITIC=qwen3.6-flash/latest
YANDEX_MODEL_CRITIC_2=qwen3.6-flash/latest
YANDEX_MODEL_CRITIC_3=qwen3.6-flash/latest
YANDEX_MODEL_SUMMARIZER=qwen3.6-flash/latest
YANDEX_MODEL_EVALUATION=qwen3.6-flash/latest
YANDEX_MODEL_KG=qwen3.6-flash/latest

# Provider-agnostic overrides (take precedence over ROUTERAI_MODEL_* / YANDEX_MODEL_*)
# MODEL_HGA=qwen/qwen3.6-flash
# MODEL_KG=qwen/qwen3.6-flash
